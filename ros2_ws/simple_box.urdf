<?xml version="1.0"?>
<robot name="simple_box">

  <link name="base_link">

    <visual>
      <geometry>
        <box size="1 1 1"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <box size="1 1 1"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>
      <inertia
        ixx="0.1667"
        ixy="0.0"
        ixz="0.0"
        iyy="0.1667"
        iyz="0.0"
        izz="0.1667"/>
    </inertial>

  </link>

</robot>
